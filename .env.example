# ---------------------------------------------------------------------------
# RoleFit environment variables.  Copy to .env and fill in.  Never commit .env.
# ---------------------------------------------------------------------------

# --- How to reach Gemini ---------------------------------------------------
# Vertex AI (recommended in production): authenticates with the service
# identity, so NO API key is needed, nothing secret ships with the deployment,
# and usage bills to this Google Cloud project. Requires aiplatform.googleapis
# .com enabled and roles/aiplatform.user on the runtime service account.
GEMINI_USE_VERTEX=false
# GOOGLE_CLOUD_PROJECT defaults to FIREBASE_PROJECT_ID when unset.
# VERTEX_LOCATION=global
# VERTEX_MODEL=gemini-3.5-flash
# VERTEX_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-3-flash-preview

# --- Gemini Developer API key (only when GEMINI_USE_VERTEX=false) ----------
# SECRET - server only, never sent to the browser.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.7-flash
# Tried in order if the primary returns 503 (high demand) or 404 (retired).
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash

# --- Firebase web SDK config (PUBLIC by design) ----------------------------
# Firebase Console > Project settings > Your apps > Web app > SDK setup.
# These ship to every browser that loads the page; that is normal and safe.
# Security comes from Firestore rules + server-side ID token verification.
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:abcdef123456

# --- Admin credentials -----------------------------------------------------
# LOCAL ONLY. On Cloud Run the service identity supplies these automatically -
# do NOT set this in production.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# --- Optional tuning -------------------------------------------------------
# PORT=8080
# FLASK_DEBUG=1
# GEMINI_TIMEOUT_S=90
# MAX_UPLOAD_BYTES=5242880
# MAX_RESUME_CHARS=20000
